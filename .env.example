# Скопируйте в .env и заполните (chmod 600). Файл .env в репозиторий не попадает.

# --- общий PAM jump-хост ---
PAM_HOST=
PAM_PORT=2222

# --- куда слать отчёты и откуда принимать команды: vk или telegram ---
MESSENGER=vk

# --- ВКонтакте (MESSENGER=vk) ---
VK_TOKEN=
VK_GROUP_ID=
VK_PEER_ID=

# --- Telegram (MESSENGER=telegram): токен от @BotFather, чат - id группы (отрицательное число) ---
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# кто может вызывать команды из беседы (id пользователей через запятую); пусто = никто
ALLOWED_USERS=
# ALLOW_ANY_USER=1                   # разрешить команды всем участникам беседы
# EXTRA_PEERS=                       # доп. получатели плановой рассылки (id через запятую)

# --- пароли целей: имя переменной указывается в targets.toml (password_env) ---
# EXAMPLE_PAM_PASSWORD=
# DIRECT_SSH_PASSWORD=
# MAILBOX_PASSWORD=

# --- необязательно ---
# SSH_STRICT_HOST_KEY=accept-new     # yes | no | accept-new
# SSH_KEX=...  SSH_HOSTKEY_ALGS=...  # добавляются к алгоритмам ssh по умолчанию
# PROMPT_NUDGE=10
# MAX_PARALLEL_LOGINS=2              # одновременных входов на шлюз
# GATEWAY_LOGIN_GAP=5                # пауза между началами входов, секунды
# VK_ATTACH_DELAY=1.5
# MAX_ROWS_PER_IMAGE=400
# SAVE_DIR=                          # куда сохранять картинки
# NO_OPEN_SCREENSHOT=1               # не открывать картинку в просмотрщике
